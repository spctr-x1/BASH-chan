KNOWN_COMMANDS = ROOT_COMMANDS | set(COMMAND_REACTIONS)
COMMAND_ARGUMENT_LIMITS = {
    "pwd": (0, 0),
    "cd": (0, 1),
    "pushd": (0, 1),
    "popd": (0, 0),
    "tree": (0, 1),
    "ping": (1, None),
    "ssh": (1, None),
    "find": (1, None),
    "mkdir": (1, None),
    "rmdir": (1, None),
    "cp": (2, None),
    "mv": (2, None),
    "chmod": (2, None),
}

#----------------------#
#Live facial reactions
#----------------------#

def failure_kind(command_parts: list[str], exit_code: int, *, parse_failed: bool) -> str | None:
    """Classify common command-line mistakes without changing command execution."""
    if parse_failed:
        return "syntax"
    if not command_parts or exit_code == 0:
        return None

    command_name = command_parts[0].rsplit("/", maxsplit=1)[-1].lower()
    arguments = command_parts[1:]
    if exit_code == 127 and command_name not in KNOWN_COMMANDS:
        return "unknown_command"
    if any(argument.startswith("-") for argument in arguments) and exit_code in {1, 2}:
        return "invalid_flag"

    argument_limits = COMMAND_ARGUMENT_LIMITS.get(command_name)
    if argument_limits is not None:
        minimum, maximum = argument_limits
        if len(arguments) < minimum:
            return "missing_arguments"
        if maximum is not None and len(arguments) > maximum:
            return "too_many_arguments"
    return None


def reaction(command: str, exit_code: int, *, rng: random.Random) -> str:
    """Choose a command-aware reaction without changing the command's result."""
    parse_failed = False
    try:
        command_parts = shlex.split(command)
    except ValueError:
        command_parts = []
        parse_failed = True

    kind = failure_kind(command_parts, exit_code, parse_failed=parse_failed)
    if kind is not None:
        return rng.choice(FAILURE_REACTIONS[kind])

    command_name = command_parts[0].rsplit("/", maxsplit=1)[-1].lower() if command_parts else ""
    root_command_positions = (0,) + tuple(
        index + 1
        for index, part in enumerate(command_parts[:-1])
        if part in SHELL_SEPARATORS
    )
    if any(
        index < len(command_parts)
        and command_parts[index].rsplit("/", maxsplit=1)[-1].lower() in ROOT_COMMANDS
        for index in root_command_positions
    ):
        root_command = next(
            (
                command_parts[index].rsplit("/", maxsplit=1)[-1].lower()
                for index in root_command_positions
                if index < len(command_parts)
                and command_parts[index].rsplit("/", maxsplit=1)[-1].lower() in ROOT_COMMAND_REACTIONS
            ),
            None,
        )
        command_reactions = ROOT_COMMAND_REACTIONS.get(root_command)
        if command_reactions:
            choices = command_reactions[0 if exit_code == 0 else 1]
        else:
            choices = ROOT_SUCCESS_REACTIONS if exit_code == 0 else ("",)
        selected_reaction = rng.choice(choices)
        return selected_reaction

    command_reactions = COMMAND_REACTIONS.get(command_name)
    if command_reactions:
        choices = command_reactions[0 if exit_code == 0 else 1]
    else:
        choices = ("",)
    selected_reaction = rng.choice(choices)
    return selected_reaction


def run_command(
    command: str,
    *,
    rng: random.Random,
    face_process: subprocess.Popen[str] | None = None,
) -> int:
    """Run a command through the user's shell and return its exit code."""
    face_paused = face_process is not None and face_process.poll() is None
    if face_paused:
        try:
            face_process.send_signal(signal.SIGSTOP)
            clear_face()
        except ProcessLookupError:
            face_paused = False
    try:
        completed = subprocess.run(command, shell=True, check=False)
    finally:
        if face_paused:
            try:
                face_process.send_signal(signal.SIGCONT)
            except ProcessLookupError:
                pass
    reaction_text = reaction(command, completed.returncode, rng=rng)
    print(f"\n[ bash-chan ] {reaction_text}")
    if face_process is not None and face_process.stdin is not None:
        try:
            face_process.stdin.write(f"{emotion_for(reaction_text, completed.returncode)}\n")
            face_process.stdin.flush()
        except (BrokenPipeError, OSError):
            pass
    return completed.returncode


def clear_face() -> None:
    """Clear the face's top terminal row while its process is paused."""
    sys.stdout.write("\0337\033[1;1H\033[2K\0338")
    sys.stdout.flush()


def history_path() -> pathlib.Path:
    """Use the user's normal shell history file for interactive commands."""
    configured_path = os.environ.get("HISTFILE")
    if configured_path:
        return pathlib.Path(os.path.expanduser(configured_path))
    return pathlib.Path.home() / ".bash_history"


def start_face() -> subprocess.Popen[str] | None:
    """Start the independent face animation when attached to a terminal."""
    if os.name != "posix" or not sys.stdout.isatty():
        return None
    executable = pathlib.Path(sys.executable if getattr(sys, "frozen", False) else __file__)
    ready_read, ready_write = os.pipe()
    environment = os.environ.copy()
    environment["BASH_CHAN_FACE_READY_FD"] = str(ready_write)
    try:
        face_process = subprocess.Popen(
            [str(executable), "--face"],
            stdin=subprocess.PIPE,
            stdout=sys.stdout,
            stderr=sys.stderr,
            env=environment,
            pass_fds=(ready_write,),
            start_new_session=True,
            text=True,
        )
        os.close(ready_write)
        os.read(ready_read, 5)
        os.close(ready_read)
        return face_process
    except OSError:
        os.close(ready_read)
        os.close(ready_write)
        return None


def load_history() -> pathlib.Path:
    """Load existing shell history and return the file to update on exit."""
    path = history_path()
    try:
        readline.read_history_file(path)
    except FileNotFoundError:
        pass
    except OSError:
        pass
    return path


def save_history(path: pathlib.Path) -> None:
    """Persist commands entered during the interactive session."""
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        readline.write_history_file(path)
    except OSError:
        pass


def shell_prompt() -> str:
    """Build a familiar shell prompt for the current location."""
    current_directory = pathlib.Path.cwd()
    home_directory = pathlib.Path.home()
    try:
        relative_directory = current_directory.relative_to(home_directory)
        displayed_directory = "~" if relative_directory == pathlib.Path(".") else f"~/{relative_directory}"
    except ValueError:
        displayed_directory = str(current_directory)
    return f"{getpass.getuser()}@{socket.gethostname()}:{displayed_directory}$ "


def interactive_loop(*, rng: random.Random) -> int:
    """Read and execute commands until the user exits."""
    history_file = load_history()
    face_process = start_face()
    sys.stdout.write("\033[?25h")
    sys.stdout.flush()
    print("Hmph. Fine, I'll help you a little bit. Type a command, or press Ctrl-D to leave.")
    try:
        while True:
            try:
                command = input(shell_prompt()).strip()
            except (EOFError, KeyboardInterrupt):
                print("\nHmph. Leaving already? F-fine, it's not like I wanted you to stay. Loser.")
                return 0

            if not command:
                continue
            if command in {"exit", "quit"}:
                print("Fine. Go, then. It's not like I'll miss you or anything.")
                return 0

            run_command(command, rng=rng, face_process=face_process)
    finally:
        save_history(history_file)
        if face_process is not None:
            face_process.terminate()
            try:
                face_process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                face_process.kill()


NEUTRAL_FACE = "(｡•ㅅ•｡)"
BLINK_FACE = "(｡-ㅅ-｡)"
FRAME_INTERVAL = 0.1
BLINK_INTERVAL = 2.8
BLINK_DURATION = 0.18


def draw_face(face: str) -> None:
    """Draw the face in the top-right while preserving the input cursor."""
    columns = shutil.get_terminal_size(fallback=(80, 24)).columns
    face = face[: max(columns - 1, 1)]
    column = max(columns - len(face) + 1, 1)
    sys.stdout.write(f"\0337\033[1;{column}H\033[2K{face}\0338")
    sys.stdout.flush()


def clear_face_screen() -> None:
    """Remove the face from the top row when the helper exits."""
    sys.stdout.write("\0337\033[1;1H\033[2K\0338")
    sys.stdout.flush()


def stop_face(_signum: int, _frame: object) -> None:
    clear_face_screen()
    raise SystemExit(0)


def face_main() -> int:
    """Render idle blinking and command-result faces in the child process."""
    signal.signal(signal.SIGTERM, stop_face)
    signal.signal(signal.SIGINT, stop_face)
    started_at = time.monotonic()
    reaction_face = None
    draw_face(NEUTRAL_FACE)
    ready_fd = os.environ.pop("BASH_CHAN_FACE_READY_FD", None)
    if ready_fd is not None:
        os.write(int(ready_fd), b"ready")
        os.close(int(ready_fd))
    while True:
        readable, _, _ = select.select([sys.stdin], [], [], FRAME_INTERVAL)
        if readable:
            message = sys.stdin.readline().strip()
            if not message:
                return 0
            reaction_face = FACE_BY_EMOTION.get(message)

        elapsed = time.monotonic() - started_at
        if reaction_face is not None:
            draw_face(reaction_face)
        else:
            blinking = elapsed % BLINK_INTERVAL < BLINK_DURATION
            draw_face(BLINK_FACE if blinking else NEUTRAL_FACE)


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="bash-chan",
        description="Run a shell command and get a short Bash-chan reaction.",
    )
    parser.add_argument(
        "command",
        nargs=argparse.REMAINDER,
        help="command and arguments to run; omit it for interactive mode",
    )
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    arguments = sys.argv[1:] if argv is None else argv
    if arguments == ["--face"]:
        return face_main()
    args = parse_args(arguments)
    rng = random.SystemRandom()

    if not args.command:
        return interactive_loop(rng=rng)

    return run_command(shlex.join(args.command), rng=rng)


if __name__ == "__main__":
    raise SystemExit(main())
